# Source de la configuration servie en production. Le Dockerfile y remplace
# __MATOMO_HOST__ par l'origine Matomo au moment de la CONSTRUCTION, et copie
# le résultat dans /etc/nginx/conf.d/.
#
# ⚠️ NE PAS revenir au mécanisme de templates de l'image nginx (envsubst au
# démarrage) : il écrit dans /etc/nginx/conf.d, que `read_only: true` interdit,
# et un tmpfs posé là appartient à root alors que le conteneur tourne en uid
# 101. nginx démarre quand même, sans aucun `server` — donc sans écouter.
# Symptôme observé : « connection refused » avec des workers bien vivants.
server {
    # 8080 et non 80 : l'image tourne sans privilèges, et un port sous 1024
    # exige root.
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    server_tokens off;

    # ⚠️ Sans ça, nginx écrit ses redirections en ABSOLU à partir de son propre
    # port d'écoute : un `/en` renvoyait « Location: http://127.0.0.1:8080/en/ ».
    # Derrière le proxy inverse, le visiteur serait expédié sur un hôte et un
    # port qui ne sortent pas de la machine. Une Location relative laisse le
    # client reconstruire l'URL depuis celle qu'il a demandée.
    absolute_redirect off;

    # Vaut pour les réponses qui ne redéfinissent aucun add_header. Toutes les
    # autres doivent inclure le fragment elles-mêmes — voir le fichier.
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    # `text/xml` ET `application/xml` : nginx sert sitemap.xml en text/xml, et
    # ne compressait donc rien avec la seule variante `application/`.
    gzip_types text/plain text/css text/xml text/xsl application/javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json;

    # `/fr/` n'est jamais généré : le français vit sur `/`. La redirection
    # permanente existe pour les liens déjà écrits à la main, et pour qu'un
    # visiteur qui devine l'URL ne tombe pas sur une 404.
    location = /fr/ { return 301 /; }
    location = /fr  { return 301 /; }

    # Redirections « sans barre finale » vers la forme canonique, DÉRIVÉES de
    # `src/i18n/routes.ts` par `npm run nginx`. Rien à tenir à la main ici :
    # ajouter une page ou une langue met le fichier à jour tout seul.
    include /etc/nginx/redirects.conf;

    # L'export produit `/index.html` ; le servir aussi sous son nom de fichier
    # créerait une seconde URL pour la même page.
    #
    # ⚠️ Le test sur $request_uri est OBLIGATOIRE. Le module `index` réécrit `/`
    # en `/index.html` EN INTERNE et repasse par les locations : un
    # `return 301 /` inconditionnel se déclenche sur cette réécriture et fait
    # boucler la page d'accueil sur elle-même. $request_uri, lui, garde
    # toujours l'adresse d'origine du client.
    location = /index.html {
        if ($request_uri = /index.html) { return 301 /; }
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # Les fichiers de `_next/static` portent un condensat dans leur nom : leur
    # contenu ne change jamais à URL constante, un an de cache est sûr.
    #
    # Pas de directive `expires` ici : elle poserait un SECOND Cache-Control à
    # côté de celui-ci, et les clients n'ont aucune règle pour départager deux
    # valeurs contradictoires.
    #
    # ⚠️ Le `^~` est OBLIGATOIRE. Sans lui, nginx continue d'évaluer les
    # locations en EXPRESSION RÉGULIÈRE, qui l'emportent sur un préfixe simple :
    # les polices de `/_next/static/media/*.woff2` tombaient dans la règle
    # `\.(png|svg|...|woff2)$` juste en dessous et n'étaient mises en cache que
    # 30 jours au lieu d'un an. Repéré par Lighthouse, pas à l'œil.
    location ^~ /_next/static/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location ~* \.(png|svg|ico|webp|woff2)$ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;
        access_log off;
    }

    # Le HTML n'est PAS mis en cache durablement : une révalidation à chaque
    # visite est le seul moyen qu'un déploiement soit visible immédiatement.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # ⚠️ `.xsl` est absent de mime.types, et servi en
    # `application/octet-stream` le navigateur téléchargerait la feuille au
    # lieu de l'appliquer.
    #
    # Corrigé par `default_type` sur CETTE adresse, surtout pas par un bloc
    # `types { text/xsl xsl; }` : en nginx, un bloc `types` REMPLACE toute la
    # table MIME du contexte au lieu de l'étendre. Posé au niveau du serveur,
    # il a fait perdre à `.xml` son `text/xml`, et le plan du site est parti
    # en téléchargement.
    location = /sitemap.xsl {
        default_type text/xsl;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # Même trou que pour `.xsl` : `.webmanifest` est absent de mime.types et
    # partait en `application/octet-stream`. La spécification demande
    # `application/manifest+json`.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # Sonde du healthcheck Compose. `access_log off` évite de noyer les vrais
    # accès sous une ligne toutes les quinze secondes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
